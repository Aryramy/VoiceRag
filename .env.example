# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# CheaperInference / STT / TTS Configuration
CHEAPER_INFERENCE_API_KEY=your_cheaper_inference_key_here
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
OPENROUTER_STT_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v4-turbo
OPENROUTER_TTS_VOICE=george

# LiveKit WebRTC Configuration
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Qdrant Local Configuration
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=enterprise_kb

