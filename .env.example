# OpenRouter API Configuration (Optional fallback provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_FAST_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# CheaperInference STT / TTS & Fast Model Configuration (Optional fallback provider)
CHEAPER_INFERENCE_API_KEY=your_cheaper_inference_key_here
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPER_INFERENCE_MODEL=deepseek-v4-flash-0731

# Google Gemini Configuration (Primary Provider for STT, LLM & TTS)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
STT_PROVIDER=gemini
TTS_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE_EN=Kore
GEMINI_TTS_VOICE_HI=Puck
GEMINI_TTS_VOICE_AR=Leda
GEMINI_TTS_DEFAULT_VOICE=Kore

# LiveKit WebRTC Configuration
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Qdrant Local Configuration
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=enterprise_kb
